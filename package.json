{
  "name": "dsh-study-notes",
  "version": "3.1.0",
  "description": "DeepSeek Harness 插件：study-notes 技能 —— 从零学一门科目，生成标准 Markdown 学习笔记库 + 本地网页学习门户，或 HTML 学习库（一节一页、双击可用、可拖演示、页内判分）。零依赖、零构建、离线可用。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "assets",
    "test"
  ],
  "scripts": {
    "test": "node test/verify-plugin.mjs && node test/check-fixture.mjs && node test/run-sample.mjs"
  },
  "author": "GamecialX <gamecialkaiju@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GamecialX/dsh-study-notes.git"
  },
  "homepage": "https://github.com/GamecialX/dsh-study-notes#readme",
  "bugs": {
    "url": "https://github.com/GamecialX/dsh-study-notes/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "skill",
    "study-notes",
    "markdown",
    "html",
    "learning",
    "teaching",
    "notes",
    "education",
    "course"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
